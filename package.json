{
  "name": "reach-international",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.8",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:clean": "node -e \"const fs=require('fs');['.','.'].forEach(()=>{});\" && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "deploy": "pnpm build && wrangler deploy",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "pages:dev": "wrangler pages dev out",
    "pages:deploy": "wrangler pages deploy out",
    "clean": "node -e \"const{rmSync}=require('fs');['.next','out'].forEach(d=>{try{rmSync(d,{recursive:true,force:true})}catch(e){}})\" && echo Cleaned"
  },
  "dependencies": {
    "@base-ui-components/react": "1.0.0-rc.0",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@radix-ui/react-visually-hidden": "^1.2.13",
    "@react-stately/utils": "^3.12.1",
    "@tailwindcss/typography": "^0.5.20",
    "@untitledui/icons": "^0.0.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^14.6.0",
    "geist": "^1.8.2",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "next": "^15.5.28",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "tailwindcss-react-aria-components": "^2.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "agentation": "^3.1.2",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.2",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "wrangler": "^4.152.0"
  }
